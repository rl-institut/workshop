rule wind_capacity_by_state:
    """Calculate total wind capacity by state"""
    input:
        turbines="data/wind_turbines.geojson",
        states="data/federal_states.geojson",
    output:
        "data/wind_capacity_by_state.geojson",
    script:
        "scripts/wind_capacity_by_state.py"


