rule create_wind_capacity_histogram:
    """Create wind capacity histogram"""
    input:
        turbines="data/wind_turbines.csv",
    output:
        "output/wind_capacity_histogram.png",
    run:
        # INSERT PYTHON CODE HERE
        # pass
        turbines = pd.read_csv(input.turbines)
        plt.hist(turbines["Nettonennleistung"], bins=20)
        plt.title("Anzahl WEA in Deutschland nach Nennleistung")
        plt.xlabel("Leistung in MW")
        plt.ylabel("Anzahl")
        plt.savefig("output/wind_capacity_histogram.png")

